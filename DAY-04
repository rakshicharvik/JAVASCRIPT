let a = 17, b = 5;console.log(a + b, a - b, a * b);   // 22 12 85console.log(a / b);                 // 3.4console.log(a % b);                 // 2console.log(a ** 2);                // 289
Example 2 — Slightly different: compound assignment as a running state
