javascript
const age = 16;const isStudent = true;const BASE_PRICE = 200;const isChild = age < 12;const isSenior = age >= 60;const getsDiscount = isChild || isSenior || isStudent;const price = getsDiscount ? BASE_PRICE / 2 : BASE_PRICE;console.log("Discount eligible:", getsDiscount);   // trueconsole.log("Price:", price);                      // 100
